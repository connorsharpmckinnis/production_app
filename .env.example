# =============================================================================
# Database — DATABASE_URL is the app source of truth (local, Neon, Cloud Run).
# Switch databases by changing DATABASE_URL below (only one active).
# POSTGRES_* configure the local Docker `db` container only; the app ignores them.
# =============================================================================

# Local Docker Postgres (default for ./scripts/dev on this machine):
DATABASE_URL=postgresql://production_app:production_app@127.0.0.1:5432/production_app

# Neon (comment out the local line above, then uncomment and fill in):
# DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST/DATABASE?sslmode=require

# Optional Neon pooler URL — not used by the app yet; keep migrations on the direct URL.
# DATABASE_URL_POOLED=postgresql://USERNAME:PASSWORD@HOST/DATABASE?sslmode=require

# Credentials for the local Docker Postgres container (docker compose db service only)
POSTGRES_USER=production_app
POSTGRES_PASSWORD=production_app
POSTGRES_DB=production_app

# Backend (read from this root .env by Settings, ./scripts/dev, and Compose)
SECRET_KEY=dev-secret-change-in-production-32chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ORG_NAME=Default Organization
ENVIRONMENT=dev

# Comma-separated browser origins allowed to call the API.
# After `tailscale serve --bg 5173`, add your https://….ts.net origin here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# In-app bug / idea reports → GitHub Issues (any logged-in user; no GitHub account needed).
# Create a fine-grained PAT with Issues: Read and write on this repo only.
# Leave empty to disable (API returns 503).
GITHUB_TOKEN=
GITHUB_REPO=connorsharpmckinnis/production_app

# Frontend (local non-Docker only; set automatically in Docker Compose)
# VITE_API_PROXY_TARGET=http://localhost:8000
